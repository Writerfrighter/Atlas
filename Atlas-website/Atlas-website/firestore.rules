rules_version = '2';

// Firestore security rules — these run on Google's servers and are the
// REAL protection for your data (anyone can read your frontend code).
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read/write ONLY their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is locked until we add rules for it
    // (chats in Phase 4, FAQs in Phase 5).
  }
}
